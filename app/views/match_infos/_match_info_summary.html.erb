<div class="col-lg-3 col-md-4 col-sm-6 my-3"> <!-- PCでは3列、スマホでは2列で表示 -->
<% draft_resume_path = match_info.serve_receive? ? new_serve_receive_match_infos_path(draft_id: match_info.id) : new_match_info_path(draft_id: match_info.id) %>
<a href="<%= match_info.draft? ? draft_resume_path : match_info_path(match_info) %>"
   class="text-decoration-none">
  <div class="card fade-in-up">
    <div class="card-body">
      <h5 class="card-title">
        <i class="fas fa-user"></i>
        <%= match_info.player.player_name %> VS <%= match_info.opponent.player_name %>
        <% if match_info.draft? %>
          <span class="badge bg-warning text-dark ms-1">下書き</span>
        <% elsif match_info.games.any? %>
          <% player_wins = match_info.games.count { |g| g.player_score > g.opponent_score } %>
          <% opponent_wins = match_info.games.count { |g| g.player_score < g.opponent_score } %>
          <span class="<%= player_wins > opponent_wins ? 'badge-win' : 'badge-lose' %> ms-1">
            <%= player_wins > opponent_wins ? '勝利' : '敗北' %>
          </span>
        <% end %>
        <% if match_info.serve_receive? %>
          <span class="badge bg-info text-dark ms-1">サーブ・レシーブ</span>
        <% elsif match_info.technique? %>
          <span class="badge bg-secondary ms-1">技術別得点率</span>
        <% end %>
      </h5>
      <p class="card-text">
        <i class="fas fa-trophy"></i>
        <%= match_info.match_name %>
      </p>
      <p class="card-text">
        <i class="fas fa-calendar-alt"></i>
        <%= match_info.match_date %>
      </p>
      <% if match_info.games.any? %>
        <p class="card-text mt-1">
          <span class="game-count-chip"><%= match_info.game_count_score %></span>
        </p>
      <% end %>
      <% if match_info.draft? %>
        <%= link_to "続きから入力", draft_resume_path, class: "btn btn-warning mt-2" %>
        <%= link_to "削除", "#", class: "btn delete-btn mt-2 ms-2",
              data: { bs_toggle: "modal", bs_target: "#deleteDraftModal_#{match_info.id}" } %>
      <% else %>
        <%= link_to "試合分析詳細", match_info, class: "btn btn-info mt-2" %>
      <% end %>
    </div>
  </div>
</a>

<% if match_info.draft? %>
  <div class="modal fade" id="deleteDraftModal_<%= match_info.id %>" tabindex="-1"
       aria-labelledby="deleteDraftModalLabel_<%= match_info.id %>" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="deleteDraftModalLabel_<%= match_info.id %>">削除の確認</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
        </div>
        <div class="modal-body">
          この下書きを本当に削除してもよろしいですか？
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">キャンセル</button>
          <%= button_to "削除する", match_info_path(match_info),
                method: :delete,
                class: "btn btn-danger" %>
        </div>
      </div>
    </div>
  </div>
<% end %>
</div>
