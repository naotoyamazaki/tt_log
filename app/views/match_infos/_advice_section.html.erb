<div class="show-container fade-in-up mb-4">
  <div class="section-card p-4 shadow-sm">
    <div class="advice-section">
      <% if advice.present? %>
        <%= simple_format(advice) %>
      <% elsif status == :busy %>
        <p class="mb-0"><%= t('notices.advice_busy') %></p>
      <% else %>
        <p class="mb-3"><%= t('notices.advice_failed') %></p>
        <%= button_to "もう一度生成する", generate_advice_match_info_path(match_info),
                      method: :post, class: "btn btn-primary",
                      form: { data: { controller: "loading-button" } },
                      data: { loading_button_target: "button", turbo: false } %>
      <% end %>
    </div>
  </div>
</div>
