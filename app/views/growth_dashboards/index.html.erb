<h1 class="center-text">📈 成長ダッシュボード</h1>

<div class="show-container fade-in-up mb-4">
  <div class="section-card p-4 shadow-sm">
    <%= form_with url: growth_dashboards_path, method: :get, local: true, class: "mb-3" do %>
      <div class="row">
        <div class="column">
          <%= label_tag :batting_style, "🏓技術を選択" %>
          <%= select_tag :batting_style,
              options_for_select(
                Score.allowed_batting_styles.map { |style| [Score.human_enum_name(:batting_style, style), style] },
                @batting_style
              ),
              class: "form-select",
              onchange: "this.form.requestSubmit()" %>
        </div>
        <div class="column">
          <%= label_tag :period, "📅表示期間" %>
          <%= select_tag :period,
              options_for_select([["月別", "month"], ["週別", "week"]], @period.to_s),
              class: "form-select",
              onchange: "this.form.requestSubmit()" %>
        </div>
        <div class="column">
          <% playstyle_options = MatchInfo.opponent_playstyles.keys.map do |key|
               [MatchInfo.human_enum_name(:opponent_playstyle, key), key]
             end %>
          <%= label_tag :opponent_playstyle, "🤝戦型で絞り込み" %>
          <%= select_tag :opponent_playstyle,
              options_for_select([["すべて", ""]] + playstyle_options, @opponent_playstyle),
              class: "form-select",
              onchange: "this.form.requestSubmit()" %>
        </div>
      </div>
    <% end %>

    <h2 class="section-title">
      <%= Score.human_enum_name(:batting_style, @batting_style) %> 得点内訳における得点構成比の推移
      （<%= @period == :week ? "週別" : "月別" %>）
    </h2>
    <p class="text-muted small">
      ※ この数値は「成功率」ではなく、その月に自分が取った得点のうち対象技術が占める割合（得点構成比）です。
    </p>

    <% if @series.empty? %>
      <p class="text-muted">
        まだ表示できる試合データがありません。試合を登録すると、<%= Score.human_enum_name(:batting_style, @batting_style) %>の得点内訳における得点構成比の推移がここに表示されます。
      </p>
      <p class="text-muted">
        試合を重ねるほど、このグラフにあなたの成長の軌跡が積み上がっていきます。
      </p>
    <% else %>
      <div
        data-controller="growth-chart"
        data-growth-chart-labels-value="<%= @series.map { |entry| entry[:period_label] }.to_json %>"
        data-growth-chart-data-value="<%= @series.map { |entry| entry[:share] }.to_json %>"
      >
        <canvas data-growth-chart-target="canvas" height="120"></canvas>
      </div>

      <div class="mt-4">
        <%= render "period_detail_table", series: @series %>
      </div>
    <% end %>
  </div>
</div>

<div class="show-container fade-in-up mb-4">
  <div class="section-card p-4 shadow-sm">
    <h2 class="section-title">🏆 戦型別勝率</h2>
    <p class="text-muted small">
      ※ 全期間を対象に、対戦相手の戦型ごとの勝率を集計しています（戦型が未設定の試合は集計対象外です）。
    </p>

    <% if @opponent_type_win_rates.empty? %>
      <p class="text-muted">
        戦型別の勝率を表示できる試合データがありません。試合登録時に対戦相手の戦型を設定すると、ここに表示されます。
      </p>
    <% else %>
      <div class="overflow-auto">
        <table class="table text-nowrap mb-0">
          <thead class="ranking-table-player-header">
            <tr>
              <th>戦型</th>
              <th class="text-center">試合数</th>
              <th class="text-center">勝数</th>
              <th class="text-center">敗数</th>
              <th class="text-center">勝率</th>
            </tr>
          </thead>
          <tbody>
            <% @opponent_type_win_rates.each do |entry| %>
              <tr>
                <td><%= entry[:type_label] %></td>
                <td class="text-center"><%= entry[:match_count] %></td>
                <td class="text-center"><%= entry[:win_count] %></td>
                <td class="text-center"><%= entry[:lose_count] %></td>
                <td class="text-center"><strong><%= entry[:win_rate] %>%</strong></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>
