<h1 class="center-text">📝 試合分析一覧</h1>

<div class="d-flex justify-content-center mb-3">
  <div class="d-flex flex-column flex-sm-row gap-2">
    <%= link_to "技術別得点率分析を開始", new_match_info_path, class: "btn btn-success" %>
    <%= link_to new_serve_receive_match_infos_path, class: "btn btn-primary" do %>
      サーブ・レシーブ分析を開始
      <span class="badge bg-danger ms-1">NEW</span>
    <% end %>
  </div>
</div>

<div class="d-flex justify-content-center mb-3">
  <a href="#analysisIntro" data-bs-toggle="collapse" role="button" aria-expanded="false" aria-controls="analysisIntro">
    2つの分析の違いは？
  </a>
</div>

<div class="collapse mb-3" id="analysisIntro">
  <div class="section-card p-4 shadow-sm">
    <div class="row">
      <div class="col-12 col-md-6 mb-3 mb-md-0">
        <h5>技術別得点率分析</h5>
        <p class="mb-0">
          得点・失点した技術を記録しAIが技術面のアドバイスを生成。自分がどの技術で得点してどの技術で失点しているか知りたい選手向け。
        </p>
      </div>
      <div class="col-12 col-md-6">
        <h5>
          サーブ・レシーブ分析
          <span class="badge bg-danger ms-1">NEW</span>
        </h5>
        <p class="mb-0">
          サーブ/レシーブ直後の3球目・4球目をパターン別で記録し、パターンごとの得点率を可視化。それを踏まえてAIが戦術面のアドバイスを生成。より深く試合を分析したい選手におすすめ。
        </p>
      </div>
    </div>
  </div>
</div>

<div data-controller="auto-save" data-auto-save-page-value="index"
     data-auto-save-restore-autosave-url-value="<%= restore_autosave_match_infos_path %>">
  <div id="autosave-banner" class="alert alert-info d-flex align-items-center justify-content-between d-none mt-3">
    <span>自動保存データがあります。続きから入力できます。</span>
    <div class="d-flex gap-2 align-items-center">
      <a href="#" id="autosave-restore-link" data-action="click->auto-save#restoreAutosave" class="btn btn-sm btn-primary">続きから入力</a>
      <button id="autosave-dismiss" type="button" data-action="click->auto-save#dismissBanner" class="btn-close" aria-label="閉じる"></button>
    </div>
  </div>
</div>

<div class="search-form-wrapper">
<%= search_form_for @q, html: { class: "row justify-content-center align-items-center g-2" } do |f| %>
  <div class="col-10 col-md-3 mb-2">
    <label class="visually-hidden" for="match_name">大会名</label>
    <div class="input-group" data-controller="autocomplete" data-autocomplete-url-value="<%= autocomplete_match_infos_path(field: 'match_name') %>" data-autocomplete-min-length-value="1">
      <span class="input-group-text"><i class="fas fa-trophy"></i></span>
      <%= f.search_field :match_name_cont, id: "match_name", class: "form-control", placeholder: "大会名", data: { autocomplete_target: "input" } %>
      <ul class="autocomplete-results list-group" data-autocomplete-target="results" hidden></ul>
    </div>
  </div>

  <div class="col-10 col-md-3 mb-2">
    <label class="visually-hidden" for="player_name">選手名</label>
    <div class="input-group" data-controller="autocomplete" data-autocomplete-url-value="<%= autocomplete_match_infos_path(field: 'player_name') %>" data-autocomplete-min-length-value="1">
      <span class="input-group-text"><i class="fas fa-user"></i></span>
      <%= f.search_field :player_player_name_cont, id: "player_name", class: "form-control", placeholder: "選手名", data: { autocomplete_target: "input" } %>
      <ul class="autocomplete-results list-group" data-autocomplete-target="results" hidden></ul>
    </div>
  </div>

  <div class="col-10 col-md-3 mb-2">
    <label class="visually-hidden" for="opponent_name">対戦相手名</label>
    <div class="input-group" data-controller="autocomplete" data-autocomplete-url-value="<%= autocomplete_match_infos_path(field: 'opponent_name') %>" data-autocomplete-min-length-value="1">
      <span class="input-group-text"><i class="fas fa-user"></i></span>
      <%= f.search_field :opponent_player_name_cont, id: "opponent_name", class: "form-control", placeholder: "対戦相手名", data: { autocomplete_target: "input" } %>
      <ul class="autocomplete-results list-group" data-autocomplete-target="results" hidden></ul>
    </div>
  </div>

  <div class="col-12 col-md-auto mb-2 text-center">
    <button type="submit" class="btn btn-primary">
      <i class="fas fa-search"></i> 検索
    </button>
  </div>
<% end %>
</div>


<% if @match_infos.empty? %>
  <div class="d-flex flex-column align-items-center mt-5">
    <i class="fas fa-chart-line fa-3x text-muted mb-3"></i>
    <p class="text-center text-muted">まだ試合の分析データがありません。
    <br>新しい試合を登録して分析を始めましょう。</p>
    <%= link_to "試合分析を開始", new_match_info_path, class: "btn btn-success btn-center-below-h1" %>
  </div>
<% else %>
  <div class="row d-flex flex-wrap justify-content-start" id="match_infos">
    <% @match_infos.each do |match_info| %>
      <%= render partial: "match_info_summary", locals: { match_info: match_info } %>
    <% end %>
  </div>

  <div class="d-flex justify-content-center mt-4">
    <%= pagy_bootstrap_nav(@pagy).html_safe %>
  </div>
<% end %>
